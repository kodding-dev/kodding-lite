# 기본 라우팅은 Gemini만 쓴다. Claude로 바꿀 노드가 있을 때만 ANTHROPIC_API_KEY 필요.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# 노드별 모델 오버라이드 (선택)
# MODEL_PLAN=gemini-2.5-flash
# MODEL_DRAFT=claude-sonnet-4-6

# MDX 출력 위치 (기본: output/posts)
# OUTPUT_DIR=output/posts

# LangSmith 트레이싱 (선택) — 키만 넣으면 LangChain이 자동으로 기록한다
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kodding-lite
